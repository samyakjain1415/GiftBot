# Copy to .env and fill in. .env is gitignored — never commit real keys.

TELEGRAM_BOT_TOKEN=

# Prava sandbox secret key from the Prava developer dashboard (sk_test_...)
PRAVA_API_KEY=

# Optional — defaults to https://sandbox.api.prava.space
PRAVA_BASE_URL=

# Google AI Studio key — powers LLM gift matching
GEMINI_API_KEY=

# serper.dev key — live Google Shopping product discovery.
# Optional: without it the bot falls back to the curated gifts.json catalog.
SERPER_API_KEY=

# --- Linq / iMessage adapter (optional, second interface) ---
# Bearer token and provisioned number from your Linq representative.
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
# Returned by: python main_linq.py subscribe https://<ngrok>.ngrok.io/webhook
# Linq shows this ONCE — save it immediately.
LINQ_WEBHOOK_SECRET=
LINQ_PORT=8080
